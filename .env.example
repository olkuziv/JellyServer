# Copy this file to .env and adjust. Every value has a working default, so `docker compose up -d --build` runs without it.
# .env is ignored by git: keep secrets (API keys, passwords) there, never in this file.

# ---- Media ----
# Folder with your libraries; mounted read-only at /media inside the container.
# In the startup wizard choose folders below /media (for example /media/movies).
MEDIA_PATH=./media

# ---- Server ----
SERVER_NAME=JellyServer
# Host port for the web UI and the Jellyfin API (80 is the default; Jellyfin's usual port is 8096).
HTTP_PORT=80
# Address clients should use to reach the server (advertised by UDP auto-discovery), for example http://192.168.1.10.
# Include the port when it is not 80, for example http://192.168.1.10:8096.
PUBLIC_URL=http://localhost
# Time zone of scheduled tasks (daily and weekly triggers use server local time).
TZ=UTC

# ---- Playback of .strm files ----
# direct   - the client plays the URL itself (no server bandwidth; the source must allow cross-origin requests in a browser)
# redirect - the server answers 302 to the URL
# proxy    - the server relays the stream (works for any source and for browsers; costs the server's bandwidth)
STRM_MODE=auto

# ---- Metadata from the internet (optional) ----
# TheMovieDb API key or read access token (https://www.themoviedb.org/settings/api). Empty = no internet metadata.
TMDB_API_KEY=

# ---- Artwork ----
# Artwork the server downloads or receives is shrunk before it is stored (JPEG quality 1-100).
IMAGE_JPEG_QUALITY=65
# Keep the original files too (uses a lot more disk space). false = only the compressed copy is stored.
IMAGE_KEEP_ORIGINAL=false
# The image cache is trimmed to this size, the least recently used files first (0 = no limit).
IMAGE_CACHE_MAX_MB=512

# ---- Transcoding ----
# Where ffmpeg writes its temporary HLS segments. Anything not on the persistent data volume is fine: the files are disposable.
TRANSCODE_TEMP_DIR=/tmp/transcodes

# ---- PostgreSQL (the bundled postgres container reads the same values) ----
DB_POSTGRES_HOST=postgres
DB_POSTGRES_USERNAME=jelly
DB_POSTGRES_PASSWORD=jelly
DB_POSTGRES_DATABASE=jelly

# ---- Redis ----
REDIS_REDIS_HOST=redis

# ---- Logging ----
# Debug logs every request (method, path, status, ms); use Information to quiet it down.
REQUEST_LOG_LEVEL=Debug

# ---- Optional: a database per module ----
# By default all modules share the database above, each in its own schema. To give a module its own server or database,
# add a connection string per module to the jellyserver service in docker-compose.yml (see docs/wiki/Deployment.md):
#   ConnectionStrings__catalog:  "Host=...;Username=...;Password=...;Database=...;Maximum Pool Size=15"
# Modules: identity, userdata, catalog, media, people, collections, settings, metadata, tasks.
