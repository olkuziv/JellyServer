{
  "Logging": {
    "Format": "json",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Username=jelly;Password=jelly;Database=jelly;Maximum Pool Size=50;No Reset On Close=true",
    "Redis": "localhost:6379"
  },
  "JellyServer": {
    "Name": "JellyServer",
    "Port": 8096,
    "DataDir": "/data",
    "Version": "10.11.0",
    "Discovery": true,
    "SlowRequestMs": 500,
    "SlowQueryMs": 200,
    "Auth": { "AdminUser": "admin", "AdminPassword": "admin" },
    "Cache": { "ItemTtl": "1.00:00:00", "QueryTtl": "00:10:00" },
    "Scanner": { "Interval": "12:00:00", "OnStartup": true, "Workers": 16, "BatchSize": 500 },
    "Playback": { "StrmMode": "direct", "PlayedThreshold": 0.9, "MinResumeFraction": 0.05 },
    "Images": { "Resize": true, "JpegQuality": 85, "RemoteFetch": true },
    "Libraries": []
  }
}
